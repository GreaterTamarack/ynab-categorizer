# Copy to .env. A variable already set in the environment is left as-is.

# YNAB Account Settings → Developer Settings (personal access token).
YNAB_ACCESS_TOKEN=
# From: cabal run ynab-plans
YNAB_PLAN_ID=

# Anthropic console API key. Default model is Claude Haiku 5.5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Shared secret sent as the X-Api-Key header on POST /runs.
API_KEY=

# Optional. Defaults shown.
# CONFIDENCE_THRESHOLD=0.8
# CONFIDENT_FLAG_COLOR=green
# REVIEW_FLAG_COLOR=yellow
# LLM_BATCH_SIZE=25
# RULES_FILE=config/vendor-rules.yaml
# PORT=3000
